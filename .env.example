# Parrotlet on JarvisLabs GPU VM - environment variable template
# Copy to .env and fill in values as needed.
#
# Optional endpoint bearer token (leave blank for open endpoint)
AUTH_TOKEN=
HOST=0.0.0.0
PORT=6006

# Hugging Face model identifier (public fallback).
MODEL_ID=ekacare/parrotlet-a-2.5-pro

# Optional local/mounted model directory. If set, takes precedence over MODEL_ID.
MODEL_DIR=

# Optional pinned model revision (branch / tag / commit hash).
MODEL_REVISION=

# Hugging Face token. Leave empty if the model is public.
HF_TOKEN=

# Quantization: none | 8bit | 4bit. Only enable after the unquantized baseline works.
QUANTIZATION=none

# Torch dtype: auto | fp16 | bf16 | fp32 | tf32.
# Note: 'tf32' uses TensorFloat-32 on RTX 6000 Pro / Ampere+ Tensor Cores for float32 precision.
DTYPE=auto

# TensorFloat-32 (TF32) architecture settings for RTX 6000 Pro (Ada Lovelace / Ampere).
# ALLOW_TF32=1 enables TF32 math on Tensor Cores for float32 matmuls and cuDNN.
ALLOW_TF32=1
# Precision level: highest (full FP32, no TF32) | high (TF32 enabled) | medium (bfloat16 / reduced TF32).
FLOAT32_MATMUL_PRECISION=high

# Device map: auto | cuda | cpu | balanced. Keep 'auto' unless you know why.
DEVICE_MAP_MODE=auto

# Where Hugging Face caches downloaded artifacts (empty = HF default).
MODEL_CACHE_DIR=

# Generation defaults. Only used after the real decoder is wired up.
MAX_NEW_TOKENS=256
TEMPERATURE=

# Language lock (decoder script ban + transcript cleaner). Both default ON.
# BAN_SCRIPT_TOKENS=1 bans Devanagari/Telugu/Gujarati/etc. token IDs at
# generate() — benchmark WIN (semWER 0.73->0.21). Set to 0 for raw output.
BAN_SCRIPT_TOKENS=1
# CLEAN_TRANSCRIPT=1 strips <noise tags>, unwraps [gloss] brackets.
CLEAN_TRANSCRIPT=1